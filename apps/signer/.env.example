# apps/signer/.env.example
# The signer process holds the signing credential. Nothing else does.

SIGNER_PORT=3002
SIGNER_TOKEN=change-me
SIGNER_DATABASE_PATH=../api/data/privent.db

# The signing credential + Sepolia RPC. Never share these with the API
# process or with the LLM/agent. If you copy this file, add real values
# and keep it out of source control.
EXECUTOR_PRIVATE_KEY=
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111
