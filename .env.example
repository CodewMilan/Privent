NODE_ENV=development
API_PORT=3001
DATABASE_PATH=./data/privent.db
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_EXPLORER_TX_URL=https://sepolia.etherscan.io/tx/

# ------------------------------------------------------------------
# Signer boundary.
# The API process must NOT hold EXECUTOR_PRIVATE_KEY.
# The signer runs as its own process (apps/signer) with its own env.
# See apps/signer/.env.example for the signer-only variables.
# ------------------------------------------------------------------
SIGNER_URL=http://127.0.0.1:3002
SIGNER_TOKEN=change-me
CHAIN_ID=11155111

# Feature flags. Only enable what is genuinely live in your environment.
LEDGER_ENABLED=false
CRE_ENABLED=false
ARC_ENABLED=false

# Live integrations
# ENS_RPC_URL=https://ethereum-rpc.publicnode.com
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# GRAPH_API_KEY=
# CIRCLE_API_KEY=
# LLM_API_KEY=
