NODE_ENV=development
API_PORT=3001
DATABASE_PATH=./data/privent.db
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Phase 4 — signer. Never given to the agent package.
# Leave unset to use the local simulated signer.
# EXECUTOR_PRIVATE_KEY=
# RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# CHAIN_ID=11155111
# NEXT_PUBLIC_EXPLORER_TX_URL=https://sepolia.etherscan.io/tx/

# Phase 5 — ENS identity (mainnet registry; txs stay on Sepolia) + Privy policies
# ENS_RPC_URL=https://ethereum-rpc.publicnode.com
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=

# Phase 6 — Ledger hardware gate + Chainlink CRE TEE simulation
# Leave LEDGER_CLI unset to use the simulated device. Confirm is dry-run only;
# the existing signer still broadcasts after the device says yes.
# Phase 7 — The Graph live Uniswap pulse + Arc USDC nanopayments
# GRAPH_API_KEY comes from Subgraph Studio. CIRCLE_ENTITY_SECRET +
# ARC_WALLET_ADDRESS are required for a live Gateway payer; without them
# Arc stays simulated and says so.
# GRAPH_API_KEY=
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
# ARC_WALLET_ADDRESS=
# LLM_API_KEY=
